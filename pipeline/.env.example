# ============================================================
# .env.example — API key template
# Copy to .env and fill in your actual keys.
# NEVER commit .env to git.
# ============================================================

# OpenRouter API key (for Phase 5 QA generation and Phase 7 generation)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (for Phase 8 LLM-as-judge evaluation)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Cerebras API Key (for RAGAS evaluation)
# Get from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Hugging Face Token (for Phase 9 Embedding API)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# Mistral API Key (for fallback generation)
# Get from: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key_here

# Cohere API Key (for Reranking in retrieval)
# Get from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# Vector Store Backend: "faiss" or "qdrant" (default)
VECTOR_STORE_BACKEND=qdrant

# Chunking Strategy: "fixed_size", "sentence_aware" (default), or "article_level"
CHUNK_STRATEGY=sentence_aware

# Qdrant Cloud (only needed if using Remote mode, otherwise runs locally on file database)
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here

