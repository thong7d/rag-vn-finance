# ============================================================
# backend/.env.example — API key template for local development
# Copy to .env and fill in your actual keys.
# NEVER commit .env to git.
# ============================================================

# ── LLM APIs ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key       # https://aistudio.google.com/apikey
MISTRAL_API_KEY=your_mistral_api_key     # https://console.mistral.ai/api-keys/
OPENROUTER_API_KEY=your_openrouter_key   # https://openrouter.ai/keys

# ── Retrieval APIs ─────────────────────────────────────────────────────────────
COHERE_API_KEY=your_cohere_api_key       # https://dashboard.cohere.com/api-keys

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
QDRANT_URL=https://YOUR_CLUSTER.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# ── HuggingFace Hub (for BM25 download at startup) ────────────────────────────
HF_TOKEN=your_hf_token                   # https://huggingface.co/settings/tokens
HF_BM25_REPO=thong7d/rag-vn-finance-bm25

# ── System Config ──────────────────────────────────────────────────────────────
CHUNK_STRATEGY=sentence_aware

# ── CORS (comma-separated origins) ────────────────────────────────────────────
# Use * for local dev, set exact Vercel domain for production
ALLOWED_ORIGINS=*
