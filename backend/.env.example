# ============================================================
# backend/.env.example — API key template for local development
# Copy to .env and fill in your actual keys.
# NEVER commit .env to git.
# ============================================================

# ── LLM APIs ──────────────────────────────────────────────────────────────────
# [REQUIRED] OpenRouter API Key (https://openrouter.ai/)
OPENROUTER_API_KEY="sk-or-v1-..."

# [REQUIRED] Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSy..."

# [OPTIONAL] Second Google Gemini API Key for Decomposition
# To avoid rate limits on the free tier when running query decomposition and generation concurrently
GEMINI_API_KEY_2="AIzaSy..."

# [REQUIRED] Mistral API Key (https://console.mistral.ai/)
MISTRAL_API_KEY="your-mistral-key"

# ── Retrieval APIs ─────────────────────────────────────────────────────────────
COHERE_API_KEY=your_cohere_api_key       # https://dashboard.cohere.com/api-keys

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
QDRANT_URL=https://YOUR_CLUSTER.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# ── HuggingFace Hub (for BM25 download at startup) ────────────────────────────
HF_TOKEN=your_hf_token                   # https://huggingface.co/settings/tokens
HF_BM25_REPO=thong7d/rag-vn-finance-bm25

# ── System Config ──────────────────────────────────────────────────────────────
CHUNK_STRATEGY=sentence_aware

# ── CORS (comma-separated origins) ────────────────────────────────────────────
# Use * for local dev, set exact Vercel domain for production
ALLOWED_ORIGINS=*
