# ── Secrets ───────────────────────────────────────────────────────────────────
.env
!.env.example
backend/.env
pipeline/.env

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
*.so
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
frontend/.env.local
frontend/.env.production

# ── Pipeline: heavy data & cache files (stored on HuggingFace Hub / GDrive) ───
pipeline/data/
pipeline/bm25/
pipeline/indexes/
pipeline/qdrant_data/
pipeline/scratch/
pipeline/__pycache__/
pipeline/src/__pycache__/
pipeline/error.log
pipeline/data/bm25_sqlite/
pipeline/.git

# ── Evaluation & Synthetic QA output (parquet/jsonl generated files) ──────────
pipeline/evaluation/*.csv
pipeline/evaluation/*.jsonl
pipeline/evaluation/*.json
pipeline/evaluation/*.parquet
pipeline/evaluation/**/*.parquet
pipeline/synthetic_qa/*.parquet
pipeline/synthetic_qa/*.jsonl
pipeline/synthetic_qa/*.json

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

